# Copiez ce fichier en .env puis renseignez votre propre clé.
# Le fichier .env n'est jamais commité (voir .gitignore).

# Clé Alchemy (gratuite) : nécessaire pour les wallets EVM et Solana et le staking WCT.
# Sans clé, Hyperliquid et Bitcoin fonctionnent quand même.
# Guide pas à pas : README, section « Obtenir votre clé Alchemy ». Vous pouvez aussi la saisir
# dans l'interface (Réglages) ; si elle est définie ici, c'est celle-ci qui compte.
ALCHEMY_API_KEY=

# Mot de passe de l'interface (8 caractères minimum). Obligatoire pour y accéder depuis un autre
# appareil (--host autre que 127.0.0.1) : la page révèle tout votre patrimoine.
# WALLET_CRYPTO_PASSWORD=

# Dossier des données (base SQLite, journaux). Par défaut : ./data (avec Docker : ne pas définir)
# WALLET_CRYPTO_DATA=./data

# Fuseau horaire des dates affichées et des échéances de staking. Par défaut : Europe/Paris
# WALLET_CRYPTO_TZ=Europe/Paris

# Intervalle de synchronisation automatique, en heures. Par défaut : 6
# WALLET_CRYPTO_SYNC_HOURS=6
